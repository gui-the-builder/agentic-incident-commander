# Bootstrap generates missing local credentials; never commit the resulting .env.
POSTGRES_PASSWORD=
DEMO_PASSWORD=
INVESTIGATION_PASSWORD=
CONTROL_TOKEN=
OPERATOR_TOKEN=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_RUNTIME=host
OLLAMA_MODEL=gemma4:12b
TOOL_TRANSPORT=direct
MODEL_TIMEOUT_SECONDS=120
AUTO_APPROVE_LOW_RISK=true
ALLOW_MEDIUM_RISK_ACTIONS=true
MAX_INVESTIGATION_ITERATIONS=8
